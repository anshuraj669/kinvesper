# --- server ---
HOST=127.0.0.1
PORT=8000
# CARE_TZ=America/New_York        # defaults to this machine's timezone

# --- storage: json (local file) | dynamodb ---
STORE=json
DATA_FILE=data/state.json
# DYNAMODB_TABLE=kinvesper

# --- Claude: none (rule-based) | bedrock | anthropic | ollama (local model) ---
LLM_PROVIDER=none
# AWS_REGION=us-east-1
# LLM_MODEL=anthropic.claude-opus-5-5
# LLM_EFFORT=low
# OLLAMA_URL=http://localhost:11434               # with LLM_PROVIDER=ollama; LLM_MODEL defaults to llama3.1

# --- caregiver SMS via Amazon SNS (empty = log only) ---
# SNS_TOPIC_ARN=
# CAREGIVER_SMS=+15551234567

# --- OAuth 2.1 with Amazon Cognito (empty issuer = auth off) ---
# PUBLIC_URL=https://kinvesper.example.com       # used as the OAuth resource URL (<PUBLIC_URL>/mcp)
# OAUTH_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
# OAUTH_AUDIENCE=<cognito app client id>
# OAUTH_SCOPES=kinvesper/mcp                     # space-separated, all required
# OAUTH_JWKS_URL=                                 # defaults to <issuer>/.well-known/jwks.json
# SERVICE_TOKEN=                                  # static bearer token for the built-in voice simulator
# SIMULATOR_KEY=                                  # with OAuth on, the simulator needs this: open /voice?key=<value>
# DASHBOARD_KEY=                                  # with OAuth on, the dashboard needs this: open /dashboard?key=<value>

# --- proactive checks (scheduler) ---
# SCHEDULER_INTERVAL_S=60                         # 0 = off (then trigger `kinvesper --check` from EventBridge)
# MISSED_DOSE_GRACE_MIN=60                        # minutes after a dose time before it counts as missed
# INACTIVITY_HOURS=4                              # quiet this long (08:00-21:00) -> alert the caregiver
# LOW_STOCK_THRESHOLD=5                           # pills left that trigger a refill reminder

# --- voice simulator speech ---
# STT_MODEL=small.en                               # Whisper model for speech-to-text (base.en is faster, less accurate); off = type only
# TTS_PROVIDER=polly                               # polly (Amazon Polly) | browser (the browser's own voice)
# TTS_VOICE=Joanna                                 # any Polly neural voice

# --- pharmacy refill simulation ---
# REFILL_STEP_SECONDS=4                           # delay between refill steps when run as a task
