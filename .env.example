# --- server ---
HOST=127.0.0.1
PORT=8000
# CARE_TZ=America/New_York        # defaults to this machine's timezone

# --- storage: json (local file) | dynamodb ---
STORE=json
DATA_FILE=data/state.json
# DYNAMODB_TABLE=kinvesper

# --- the voice agent's brain: anthropic (Claude API) | bedrock | ollama (local model) | none (rule-based) ---
LLM_PROVIDER=anthropic
# Claude API key (sk-ant-...) from platform.claude.com; `make claude-key` copies it to AWS
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5                       # default; claude-sonnet-5-5 answers faster
# LLM_EFFORT=low
# AWS_REGION=us-east-1                            # with LLM_PROVIDER=bedrock (LLM_MODEL=anthropic.claude-opus-5-5)
# OLLAMA_URL=http://localhost:11434               # with LLM_PROVIDER=ollama (LLM_MODEL=llama3.1)

# --- phone calls for urgent alerts, through Twilio (needs an upgraded account) ---
# `make twilio` copies these to AWS. Pressing 1 on the call acknowledges the alert (needs PUBLIC_URL).
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15551234567                        # your Twilio number

# --- Telegram alerts bot (free; see telegram/README.md). `make telegram` copies it to AWS ---
# TELEGRAM_BOT_TOKEN=1234567890:AA...             # from @BotFather
# --- caregiver SMS via Amazon SNS (empty = log only) ---
# SNS_TOPIC_ARN=
# CAREGIVER_SMS=+15551234567

# --- OAuth 2.1 with Amazon Cognito (empty issuer = auth off) ---
# PUBLIC_URL=https://kinvesper.example.com       # used as the OAuth resource URL (<PUBLIC_URL>/mcp)
# OAUTH_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
# OAUTH_AUDIENCE=<cognito app client id>
# OAUTH_SCOPES=kinvesper/mcp                     # space-separated, all required
# OAUTH_JWKS_URL=                                 # defaults to <issuer>/.well-known/jwks.json
# SERVICE_TOKEN=                                  # static bearer token for the built-in voice simulator
# SIMULATOR_KEY=                                  # with OAuth on, the simulator needs this: open /voice?key=<value>
# DASHBOARD_KEY=                                  # with OAuth on, the dashboard needs this: open /dashboard?key=<value>
# LOGIN_CLIENT_ID=                                # Cognito app client for caregiver sign-in (/auth/login), beside the key
# CAREGIVER_LOGINS=                               # more emails that may sign in with Google (comma-separated)
# ALEXA_ACCOUNT_LINKING=required                  # the Alexa skill answers only once a family login is linked
# AMAZON_SITE=amazon.in                           # where wish list items are found; default from CARE_TZ

# --- proactive checks (scheduler) ---
# SCHEDULER_INTERVAL_S=60                         # 0 = off (then trigger `kinvesper --check` from EventBridge)
# MISSED_DOSE_GRACE_MIN=60                        # minutes after a dose time before it counts as missed
# INACTIVITY_HOURS=4                              # quiet this long (08:00-21:00) -> alert the caregiver
# LOW_STOCK_THRESHOLD=5                           # pills left that trigger a refill reminder

# --- voice simulator speech ---
# STT_PROVIDER=whisper                             # whisper (local) | transcribe (Amazon Transcribe) | off (type only)
# STT_MODEL=small.en                               # Whisper model (base.en is faster, less accurate)
# TTS_PROVIDER=polly                               # polly (Amazon Polly) | browser (the browser's own voice)
# TTS_VOICE=Joanna                                 # any Polly neural voice

# --- pharmacy refill simulation ---
# REFILL_STEP_SECONDS=4                           # delay between refill steps when run as a task
